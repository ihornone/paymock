{
  "name": "paymock",
  "version": "1.0.0",
  "description": "Multi-tenant Acquiring Mock on Cloudflare Workers & D1",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "next dev -p 8787",
    "build": "NODE_ENV=production next build && NODE_ENV=production opennextjs-cloudflare build --skipBuild --dangerouslyUseUnsupportedNextVersion",
    "start": "next start -p 8787",
    "dev:worker": "wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "db:init:local": "wrangler d1 execute paymock-db --local --file=./schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "tsx tests/unit/pagination.test.ts && tsx tests/unit/api-client.test.ts && tsx tests/unit/logger-errors.test.ts",
    "test:e2e": "tsx tests/api.test.ts",
    "mcp": "tsx src/features/mcp/cli.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.1",
    "@clerk/localizations": "^4.23.0",
    "@clerk/nextjs": "^7.9.14",
    "@clerk/themes": "^2.4.57",
    "@hono/clerk-auth": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tabler/icons-react": "^3.49.0",
    "autoprefixer": "^10.6.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.7.4",
    "lucide-react": "^1.54.0",
    "marked": "^18.1.0",
    "next": "15.1.7",
    "postcss": "^8.5.29",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@opennextjs/cloudflare": "^1.20.10",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/marked": "^6.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "wrangler": "^3.114.0"
  }
}
