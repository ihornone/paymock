# Public application URL — used to build checkout / invoice links.
NEXT_PUBLIC_APP_URL=http://localhost:8787

# Clerk publishable key (safe to expose to the browser).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Clerk secret key — server only, never expose to the client.
CLERK_SECRET_KEY=sk_test_replace_me

# Cloudflare D1 (production binding is configured in wrangler.toml).
CLOUDFLARE_ACCOUNT_ID=e468b6b0d602ac91b1c044b15a4c4fbe
CLOUDFLARE_DATABASE_ID=29ae1343-80a1-46ff-a3c6-b521dcfb9e5a

# Token used by the local D1 HTTP bridge (dev only).
# Without it the dev server cannot reach the remote D1 database.
CLOUDFLARE_API_TOKEN=replace_me

# Optional: explicit CORS allow-list for the MCP endpoint.
# When unset, the endpoint answers with `Access-Control-Allow-Origin: *`,
# which is safe because MCP clients authenticate with an X-Token header
# (never with cookies).
MCP_ALLOWED_ORIGINS=

# Optional: log level — error | warn | info | debug
LOG_LEVEL=info
